{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "Mode": "restricted",
    "AllowedOrigins": []
  },
  "JwtOptions": {
    "Secret": "",
    "SessionTimeout": "08:00:00",
    "ConsumerSecret": ""
  },
  "Swagger": {
    "Enabled": false
  },
  "SwaggerOptions": {
    "Users": []
  },
  "Errors": {
    "IncludeDetails": false
  },
  "Demo": {
    "Enabled": false
  },
  "DbOptions": {
    "Provider": "PostgreSql",
    "Port": "5432",
    "UserId": "",
    "Password": "",
    "Name": "carcare",
    "MultiTenancy": {
      "Enabled": false,
      "Suffix": {
        "Tenancy": "tenancy",
        "Template": "template"
      }
    }
  },
  "DatabaseBackup": {
    "Program": ""
  },
  "Email": {
    "Provider": "Smtp",
    "Smtp": {
      "Port": 587,
      "Security": "Auto"
    }
  },
  "Authentication": {
    "EmailCode": {
      "RequireForPasswordLogin": true,
      "AllowUsersWithoutEmail": false,
      "CodeLifetimeMinutes": 10,
      "MaxAttempts": 5,
      "MaxSends": 3
    },
    "PasswordReset": {
      "Enabled": true
    },
    "Microsoft": {
      "Enabled": false,
      "TenantId": "common",
      "Instance": "https://login.microsoftonline.com"
    }
  }
}
