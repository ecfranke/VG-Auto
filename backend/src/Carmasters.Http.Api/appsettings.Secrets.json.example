{
  "PdfDirectory": "/var/carcare/pdf",
  "PuppeteerPath": "/opt/puppeteer",
  "JwtOptions": {
    "Secret": "[your-jwt-secret]",
    "ConsumerSecret": "[your-server-secret]"
  },
  "DbOptions": {
    "Host": "localhost",
    "Port": 5432,
    "UserId": "carcare",
    "Password": "[your-db-password]",
    "Name": "carcare",
    "MultiTenancy": {
      "Enabled": false
    }
  },
  "DefaultAdmin": {
    "UserName": "admin",
    "Email": "",
    "Password": ""
  },
  "SmtpOptions": {
    "Host": "localhost",
    "Port": "1025",
    "User": "",
    "Password": ""
  },
  "Cors": {
    "Mode": "restricted",
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
