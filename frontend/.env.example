# must equal JwtOptions:ConsumerSecret in appsettings.Secrets.json
SERVER_SECRET=[your-server-secret]

# used for your own session-cookie encryption
SESSION_SECRET=[random-32-byte-base64]

# API endpoint used by the Next.js server
API_URL=http://localhost:15567
# API endpoint used by the browser (must be reachable from users' browsers)
NEXT_PUBLIC_API_URL=http://localhost:15567

# Session cookies are sent only over HTTPS when true (default: true in production builds).
# Set to false only when the app is served over plain HTTP, e.g. on a trusted LAN.
# COOKIE_SECURE=true

# Optional: match your server timeouts
NEXT_PUBLIC_SESSION_TIMEOUT=1500
NEXT_PUBLIC_SESSION_DIALOG_TIMEOUT=120
