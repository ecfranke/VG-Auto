@using VgAuto.Core.Application.Configuration
@using VgAuto.Core.Application.Model
@using VgAuto.Core.Domain
@using VgAuto.Http.Api
@model PricingPrintModel
@{
    var pricing = (Pricing)Model.Pricing;
    var requisitesOptions = (RequisitesOptions)Model.RequisitesOptions;
    var pricingOptions = (PricingOptions)Model.PricingOptions;
    var isInvoice = pricing is VgAuto.Core.Domain.Invoice;
    var hasDiscounts = pricing.Lines.Any(x => x.Discount != 0);
    // documents issued before currencies existed use the company currency
    var currency = Currencies.Normalize(pricing.Currency ?? pricingOptions.Currency);
    // "$" is used by several currencies: add the code to the total so it is clear which dollar
    var showCode = Currencies.Format(0, currency).Contains('$');
    string Money(decimal amount) => Currencies.Format(amount, currency);
    string Number(decimal amount) => Currencies.FormatNumber(amount, currency);
    string Unit(string unit) => unit == "tk" ? "pcs" : unit; // Estonian unit of older lines
    string Rate(decimal rate) => rate.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
  
<div class="grid grid-cols-2">
    <div>
        <h1 class=" text-blue-600 font-medium text-3xl" id="logo">@requisitesOptions.Name</h1>
        <p class="text-lg text-gray-500">@requisitesOptions.Phone</p>
    </div>
    <div class="text-right">
        <p class="text-2xl font-medium text-gray-500">
            @(pricing.GetTitle())
        </p>
        <p class="text-lg font-medium text-gray-500">@(pricing.GetNumber())</p>
        @if (!string.IsNullOrWhiteSpace(pricing.VehicleTitle))
        {
            <p class="text-base text-gray-900" id="vehicle">@pricing.VehicleTitle</p>
        }
    </div>
</div>
 
<div class="grid grid-cols-2 mt-8">
    <div>
        @{
            await Html.RenderPartialAsync("Print/LeftTop." + pricing.GetType().Name, (object)Model);
        }
    </div>

    <div class="text-right">
        <p class="text-sm text-gray-500">@pricing.PartyName</p>
        @if (!string.IsNullOrWhiteSpace(pricing.PartyCode))
        {
            <p class="text-sm text-gray-500"> @pricing.PartyCode</p>

        }
        @if (!string.IsNullOrWhiteSpace(pricing.PartyAddress))
        {
            <p class="text-sm text-gray-500 whitespace-pre-line">@pricing.PartyAddress</p>
        }
    </div>
</div>
<table border="1" class="mt-2 min-w-full divide-y divide-gray-300">
    <thead>
        <tr>
            <th class="pl-0 pr-2 py-1 text-start font-light text-sm font-semibold text-gray-900">Service / Product name</th>
            <th class="px-2 py-1 text-end font-light text-sm font-semibold whitespace-nowrap text-gray-900">Quantity</th>
            <th class="px-2 py-1 text-end font-light text-sm font-semibold whitespace-nowrap text-gray-900">Unit</th>
            <th class="px-2 py-1 text-end font-light text-sm font-semibold whitespace-nowrap text-gray-900">Unit price</th>
            @if (hasDiscounts)
            {
                <th class="px-2 py-1 text-end font-light text-sm font-semibold whitespace-nowrap text-gray-900">Discount %</th>
            }
            <th class="pl-2 pr-0 py-1 text-end font-light text-sm font-semibold whitespace-nowrap text-gray-900">Amount (@currency)</th>
        </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 bg-white">
        @foreach (var item in pricing.Lines)
        {

            <tr>
                <td class="w-full text-start pl-0 pr-2 py-1 text-sm text-gray-900">@item.Description</td>
                <td class="w-15 text-end px-2 py-1 text-sm whitespace-nowrap text-gray-900">@(item.Quantity?.ToString("0.###", Currencies.CultureOf(currency)))</td>
                <td class="w-15 text-end px-2 py-1 text-sm whitespace-nowrap text-gray-900">@Unit(item.Unit)</td>
                <td class="w-15 text-end px-2 py-1 text-sm whitespace-nowrap text-gray-900">@Number(item.UnitPrice)</td>
                @if (hasDiscounts)
                {
                    <td class="w-15 text-end px-2 py-1 text-sm whitespace-nowrap text-gray-900">@((item.Discount != null && item.Discount != 0) ? $"{item.Discount} %" : String.Empty)</td>
                }
                <td class="w-15 text-end pl-2 pr-0 py-1 text-sm whitespace-nowrap text-gray-900">@Number(item.Total)</td>
            </tr>
        }
    </tbody>
    <tfoot class="border-t-2 border-blue-600">
        <tr>
            <td></td>
        </tr>
    </tfoot>
</table>
<div class="pricesummary grid grid-cols-2">
    <div>
        <div class="grid grid-rows-3 gap-2 pt-2 pl-0">
            <p class=" pt-2 text-start text-sm font-light text-gray-900 pl-0">
                @(pricing.VehicleLine1)
            </p>
            <p class="pt-2 text-start text-sm font-light text-gray-900 pl-0">
                @(pricing.VehicleLine2)
            </p>
            <p class="pt-2 text-start text-sm font-light text-gray-900 pl-0">
                @(pricing.VehicleLine3)
            </p>
            <p class="pt-2 text-start text-sm font-light text-gray-900 pl-0">
                @(pricing.VehicleLine4)
            </p>
        </div>
    </div>
    <div class="text-right">
        <table class="text-sm" style="margin-left:auto;margin-top:0.5rem">
            <tr>
                <td class="text-right font-light text-gray-500" style="padding:0.25rem 1rem 0 0">Subtotal</td>
                <td class="text-right font-light text-gray-500 whitespace-nowrap" style="padding-top:0.25rem">@Money(pricing.GetTotal(false))</td>
            </tr>
            @foreach (var tax in pricing.GetTaxes())
            {
                <tr>
                    <td class="text-right font-light text-gray-500" style="padding:0.25rem 1rem 0 0">@tax.Name@(tax.Rate > 0 ? $" ({Rate(tax.Rate)}%)" : "")</td>
                    <td class="text-right font-light text-gray-500 whitespace-nowrap" style="padding-top:0.25rem">@Money(tax.Amount)</td>
                </tr>
            }
            <tr>
                <td class="text-right font-semibold text-gray-900" style="padding:0.5rem 1rem 0 0">@(isInvoice ? "Total due" : "Total")</td>
                <td class="text-right font-semibold text-gray-900 whitespace-nowrap" style="padding-top:0.5rem">@Money(pricing.GetTotal(true))@(showCode ? " " + currency : "")</td>
            </tr>
        </table>
    </div>
</div>
<div class="grid grid-cols-2 mt-2 ">
    <div>
        @{
            await Html.RenderPartialAsync("Print/LeftBottom." + pricing.GetType().Name, pricing);
        }

    </div>
    <div class="float-right">
        <div>
            @{
                await Html.RenderPartialAsync("Print/RightBottom." + pricing.GetType().Name, pricingOptions);
            }
        </div>

    </div>
</div>
<div class="grid grid-cols-2 ">
    <div>
        @if (isInvoice && pricingOptions.Invoice.SignatureLine == true)
        {
            <p class="mt-8 text-sm text-gray-500">Signature: ____________________</p>
        }

    </div>
    <div class="float-right">
        @if (isInvoice && pricingOptions.Invoice.SignatureLine == true)
        {
            <p class="mt-8 text-sm text-gray-500">Customer signature: ____________________</p>
        }
        @if (Model.Signature != null)
        {
            <div class="mt-8 text-sm text-gray-900" id="customer-signature">
                <p class="text-gray-500">Accepted and signed by the customer</p>
                <img src="@Model.Signature.Image" alt="Signature of @Model.Signature.SignerName" style="height:64px;max-width:260px;display:block;margin:0.25rem 0" />
                <p>@Model.Signature.SignerName</p>
                <p class="text-gray-500">Signed online @Model.Signature.SignedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
            </div>
        }
    </div>
</div>
<footer class="border-t border-gray-200 w-full min-w-full grid grid-cols-2 ">
    <div class="mt-2">
        <p class="text-xs">
            @requisitesOptions.Name
        </p>
        <p class="text-xs">
            @requisitesOptions.Address
        </p>
        <p class="text-xs">
            @requisitesOptions.Email
        </p>
    </div>
    <div class="mt-2 text-right">
        <div>
            @if (pricingOptions.Invoice.ShowBankAccount == true && !string.IsNullOrWhiteSpace(requisitesOptions.BankAccount))
            {
                <p class="text-xs">Bank account: @requisitesOptions.BankAccount</p>
            }
            @if (pricingOptions.Invoice.ShowRegNo == true && !string.IsNullOrWhiteSpace(requisitesOptions.RegNr))
            {
                <p class="text-xs">Reg No: @requisitesOptions.RegNr</p>
            }
            @if (!string.IsNullOrWhiteSpace(requisitesOptions.KMKR))
            {
                <p class="text-xs">@Model.TaxIdLabel: @requisitesOptions.KMKR</p>
            }
        </div>
    </div>
</footer>