{
  "PdfDirectory": "/var/lib/vg-auto/pdf",
  "PuppeteerPath": "/opt/puppeteer",
  "JwtOptions": {
    "Secret": "[your-jwt-secret]",
    "ConsumerSecret": "[your-server-secret]"
  },
  "DbOptions": {
    "Provider": "PostgreSql",
    "Host": "localhost",
    "Port": 5432,
    "UserId": "vgauto",
    "Password": "[your-db-password]",
    "Name": "vgauto",
    "MultiTenancy": {
      "Enabled": false
    }
  },
  "DefaultAdmin": {
    "UserName": "admin",
    "Email": "",
    "Password": ""
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "",
    "FromName": "",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "User": "",
      "Password": "",
      "Security": "Auto"
    },
    "Graph": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "Sender": "",
      "SaveToSentItems": true
    }
  },
  "Authentication": {
    "EmailCode": {
      "RequireForPasswordLogin": true
    },
    "Microsoft": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "TenantId": "common"
    }
  },
  "Cors": {
    "Mode": "restricted",
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
